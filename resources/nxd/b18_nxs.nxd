@default = entry
entry:
	@NX_class = NXentry
	@default = data
	definition:NX_CHAR = "NXxas"
	title:NX_CHAR = "general_source_file"
	instrument:
		@NX_class = NXinstrument
		name:NX_CHAR = nexus_entry1_instrument_name
		source:
			@NX_class = NXsource
			name:NX_CHAR = nexus_entry1_instrument_source_name
			probe:NX_CHAR = nexus_entry1_instrument_source_probe
			type:NX_CHAR = nexus_entry1_instrument_source_type
			energy:NX_FLOAT64 = nexus_entry1_instrument_source_energy
				@units = "GeV"
			current:NX_FLOAT64 = nexus_entry1_instrument_source_current
				@units = "mA"
		monochromator:
			@NX_class = NXmonochromator
			energy:NX_FLOAT64[] = diamond_qexafs_energy
		incoming_beam:
			@NX_class = NXdetector
			data:NX_FLOAT64[] = diamond_i0
		absorbed_beam:
			@NX_class = NXdetector
			data:NX_FLOAT64[] = diamond_it
	sample:
		@NX_class = NXsample
	monitor:
		@NX_class = NXmonitor
		mode:NX_CHAR = "timer"
		data:NX_FLOAT64[] = diamond_i0
	data:
		@NX_class = NXdata
		@signal = absorbed_beam
		@axes = energy
		energy: --> /entry/instrument/monochromator/energy
		absorbed_beam: --> /entry/instrument/absorbed_beam/data
		incoming_beam: --> /entry/instrument/incoming_beam/data
		mode:NX_CHAR = "Transmission"
	metadata:
		@NX_class = NXcollection
		general_nexus_file:NX_CHAR = "general_nexus_file"
		nexus_entry1_before_scan_Detector_Parameters:NX_CHAR = "nexus_entry1_before_scan_Detector_Parameters"
		nexus_entry1_before_scan_Output_Parameters:NX_CHAR = "nexus_entry1_before_scan_Output_Parameters"
		nexus_entry1_before_scan_QEXAFS_Parameters:NX_CHAR = "nexus_entry1_before_scan_QEXAFS_Parameters"
		nexus_entry1_before_scan_Sample_Parameters:NX_CHAR = "nexus_entry1_before_scan_Sample_Parameters"
		nexus_entry1_before_scan_xmlFolderName:NX_CHAR = "nexus_entry1_before_scan_xmlFolderName"
		nexus_entry1_entry_identifier:NX_CHAR = "nexus_entry1_entry_identifier"
		nexus_entry1_experiment_identifier:NX_CHAR = "nexus_entry1_experiment_identifier"
		nexus_entry1_instrument_BeamFilter_A1:NX_CHAR = "nexus_entry1_instrument_BeamFilter_A1"
		nexus_entry1_instrument_DoubleCrystal_dcm_crystal:NX_CHAR = "nexus_entry1_instrument_DoubleCrystal_dcm_crystal"
		nexus_entry1_instrument_ExperimentalSlit_s4xcentre:NX_FLOAT64 = nexus_entry1_instrument_ExperimentalSlit_s4xcentre
			@units = "mm"
		nexus_entry1_instrument_ExperimentalSlit_s4xsize:NX_FLOAT64 = nexus_entry1_instrument_ExperimentalSlit_s4xsize
			@units = "mm"
		nexus_entry1_instrument_ExperimentalSlit_s4ycentre:NX_FLOAT64 = nexus_entry1_instrument_ExperimentalSlit_s4ycentre
			@units = "mm"
		nexus_entry1_instrument_ExperimentalSlit_s4ysize:NX_FLOAT64 = nexus_entry1_instrument_ExperimentalSlit_s4ysize
			@units = "mm"
		nexus_entry1_instrument_HRMirror_hr_coating:NX_CHAR = "nexus_entry1_instrument_HRMirror_hr_coating"
		nexus_entry1_instrument_HRMirror_hr_inout:NX_CHAR = "nexus_entry1_instrument_HRMirror_hr_inout"
		nexus_entry1_instrument_HRMirror_hrpitch:NX_FLOAT64 = nexus_entry1_instrument_HRMirror_hrpitch
			@units = "mrad"
		nexus_entry1_instrument_HRMirror_hry:NX_FLOAT64 = nexus_entry1_instrument_HRMirror_hry
			@units = "mm"
		nexus_entry1_instrument_HRMirror_hry1:NX_FLOAT64 = nexus_entry1_instrument_HRMirror_hry1
			@units = "mm"
		nexus_entry1_instrument_HRMirror_hry2:NX_FLOAT64 = nexus_entry1_instrument_HRMirror_hry2
			@units = "mm"
		nexus_entry1_instrument_Mirror2_m2b:NX_FLOAT64 = nexus_entry1_instrument_Mirror2_m2b
			@units = "mm"
		nexus_entry1_instrument_Mirror2_m2pitch:NX_FLOAT64 = nexus_entry1_instrument_Mirror2_m2pitch
			@units = "mrad"
		nexus_entry1_instrument_Mirror2_m2y:NX_FLOAT64 = nexus_entry1_instrument_Mirror2_m2y
			@units = "mm"
		nexus_entry1_instrument_Mirror2_m2y1:NX_FLOAT64 = nexus_entry1_instrument_Mirror2_m2y1
			@units = "mm"
		nexus_entry1_instrument_Mirror2_m2y2:NX_FLOAT64 = nexus_entry1_instrument_Mirror2_m2y2
			@units = "mm"
		nexus_entry1_instrument_Mirror2_m2yaw:NX_FLOAT64 = nexus_entry1_instrument_Mirror2_m2yaw
			@units = "mm"
		nexus_entry1_instrument_OHMirror_oh_coating:NX_CHAR = "nexus_entry1_instrument_OHMirror_oh_coating"
		nexus_entry1_instrument_PostDCMslit_s3xcentre:NX_FLOAT64 = nexus_entry1_instrument_PostDCMslit_s3xcentre
			@units = "mm"
		nexus_entry1_instrument_PostDCMslit_s3xsize:NX_FLOAT64 = nexus_entry1_instrument_PostDCMslit_s3xsize
			@units = "mm"
		nexus_entry1_instrument_PostDCMslit_s3ycentre:NX_FLOAT64 = nexus_entry1_instrument_PostDCMslit_s3ycentre
			@units = "mm"
		nexus_entry1_instrument_PostDCMslit_s3ysize:NX_FLOAT64 = nexus_entry1_instrument_PostDCMslit_s3ysize
			@units = "mm"
		nexus_entry1_instrument_PrimarySlit_s1xcentre:NX_FLOAT64 = nexus_entry1_instrument_PrimarySlit_s1xcentre
			@units = "mm"
		nexus_entry1_instrument_PrimarySlit_s1xsize:NX_FLOAT64 = nexus_entry1_instrument_PrimarySlit_s1xsize
			@units = "mm"
		nexus_entry1_instrument_PrimarySlit_s1ycentre:NX_FLOAT64 = nexus_entry1_instrument_PrimarySlit_s1ycentre
			@units = "mm"
		nexus_entry1_instrument_PrimarySlit_s1ysize:NX_FLOAT64 = nexus_entry1_instrument_PrimarySlit_s1ysize
			@units = "mm"
		nexus_entry1_instrument_SecondarySlit_s2xcentre:NX_FLOAT64 = nexus_entry1_instrument_SecondarySlit_s2xcentre
			@units = "mm"
		nexus_entry1_instrument_SecondarySlit_s2xsize:NX_FLOAT64 = nexus_entry1_instrument_SecondarySlit_s2xsize
			@units = "mm"
		nexus_entry1_instrument_SecondarySlit_s2ycentre:NX_FLOAT64 = nexus_entry1_instrument_SecondarySlit_s2ycentre
			@units = "mm"
		nexus_entry1_instrument_SecondarySlit_s2ysize:NX_FLOAT64 = nexus_entry1_instrument_SecondarySlit_s2ysize
			@units = "mm"
		nexus_entry1_instrument_StanfordAmplifiers_i0_stanford_offset:NX_INT64 = "nexus_entry1_instrument_StanfordAmplifiers_i0_stanford_offset"
			@units = pA
		nexus_entry1_instrument_StanfordAmplifiers_i0_stanford_sensitivity:NX_INT64 = "nexus_entry1_instrument_StanfordAmplifiers_i0_stanford_sensitivity"
			@units = nA/V
		nexus_entry1_instrument_StanfordAmplifiers_iref_stanford_offset:NX_INT64 = "nexus_entry1_instrument_StanfordAmplifiers_iref_stanford_offset"
			@units = pA
		nexus_entry1_instrument_StanfordAmplifiers_iref_stanford_sensitivity:NX_INT64 = "nexus_entry1_instrument_StanfordAmplifiers_iref_stanford_sensitivity"
			@units = nA/V
		nexus_entry1_instrument_StanfordAmplifiers_it_stanford_offset:NX_INT64 = "nexus_entry1_instrument_StanfordAmplifiers_it_stanford_offset"
			@units = pA
		nexus_entry1_instrument_StanfordAmplifiers_it_stanford_sensitivity:NX_INT64 = "nexus_entry1_instrument_StanfordAmplifiers_it_stanford_sensitivity"
			@units = nA/V
		nexus_entry1_instrument_qexafs_counterTimer01_I0:NX_FLOAT64[] = nexus_entry1_instrument_qexafs_counterTimer01_I0
		nexus_entry1_instrument_qexafs_counterTimer01_Iref:NX_FLOAT64[] = nexus_entry1_instrument_qexafs_counterTimer01_Iref
		nexus_entry1_instrument_qexafs_counterTimer01_It:NX_FLOAT64[] = nexus_entry1_instrument_qexafs_counterTimer01_It
		nexus_entry1_instrument_qexafs_counterTimer01_description:NX_CHAR = "nexus_entry1_instrument_qexafs_counterTimer01_description"
		nexus_entry1_instrument_qexafs_counterTimer01_id:NX_CHA = "nexus_entry1_instrument_qexafs_counterTimer01_id"
		nexus_entry1_instrument_qexafs_counterTimer01_lnI0It:NX_FLOAT64[] = nexus_entry1_instrument_qexafs_counterTimer01_lnI0It
		nexus_entry1_instrument_qexafs_counterTimer01_lnItIref:NX_FLOAT64[] = nexus_entry1_instrument_qexafs_counterTimer01_lnItIref
		nexus_entry1_instrument_qexafs_counterTimer01_time:NX_FLOAT64[] = nexus_entry1_instrument_qexafs_counterTimer01_time
		nexus_entry1_instrument_qexafs_counterTimer01_type:NX_CHAR = "nexus_entry1_instrument_qexafs_counterTimer01_type"
		nexus_entry1_instrument_qexafs_energy_qexafs_energy:NX_FLOAT64[] = nexus_entry1_instrument_qexafs_energy_qexafs_energy
		nexus_entry1_instrument_qexafs_energy_soft_limit_max:NX_FLOAT64 = nexus_entry1_instrument_qexafs_energy_soft_limit_max
		nexus_entry1_instrument_qexafs_energy_soft_limit_min:NX_FLOAT64 = nexus_entry1_instrument_qexafs_energy_soft_limit_min
		nexus_entry1_program_name:NX_CHAR = "nexus_entry1_program_name"
		nexus_entry1_scan_command:NX_CHAR = "nexus_entry1_scan_command"
		nexus_entry1_scan_dimensions:NX_INT64 = nexus_entry1_scan_dimensions
		nexus_entry1_scan_identifier:NX_CHAR = "nexus_entry1_scan_identifier"
		nexus_entry1_user01_username:NX_CHAR = "nexus_entry1_user01_username"
		diamond_time:NX_FLOAT64[] = diamond_time
		diamond_iref:NX_FLOAT64[] = diamond_iref
		diamond_lni0it:NX_FLOAT64[] = diamond_lni0it
		diamond_lnitiref:NX_FLOAT64[] = diamond_lnitiref
		general_command:NX_CHAR = "general_command"